# Normalise line endings: LF in the repository for text, native on checkout is
# left to the platform's core.autocrlf. Force LF for shell scripts.
* text=auto

*.sh   text eol=lf
*.cmake text
CMakeLists.txt text
*.cpp  text
*.hpp  text
*.txt  text
*.json text
*.md   text

# Treat these as binary.
*.png binary
*.ico binary
*.qm  binary
*.ktx binary
# The feedback sounds are PCM WAV: a line-ending or encoding conversion would
# make them undecodable, and data.sounds compares their bytes.
*.wav binary

# The fuzzers' seed inputs and the inputs that once crashed a reader are bytes, not text: some are
# deliberately CRLF, truncated or not text at all, and a conversion would change what they test.
libs/*/fuzz/corpus/** binary
libs/*/fuzz/regressions/** binary

# The interface's catalogues are generated by lupdate, which writes LF: the
# drift check compares them as text, so a checkout must not give them CRLF.
*.ts text eol=lf

# Git hooks are run by sh: LF only, whatever the checkout platform.
tools/hooks/* text eol=lf

# What a source archive (git archive, the release's source tarball) leaves out:
# the repository's own automation, the design review material and the
# performance tier. A tree cut this way builds with -DSNS_BUILD_TESTS=OFF;
# tests/CMakeLists.txt says so when it finds libs/core/bench missing.
/.github export-ignore
/docs/design export-ignore
/libs/core/bench export-ignore

# The vcpkg overlay ports are patched with git apply, which wants the bytes the patch was made from.
cmake/vcpkg-ports/** -text
