# Normalise line endings: LF in the repository for text, native on checkout is
# left to the platform's core.autocrlf. Force LF for shell scripts.
* text=auto

*.sh   text eol=lf
*.bat  text eol=crlf
*.cmake text
CMakeLists.txt text
*.cpp  text
*.hpp  text
*.txt  text
*.json text
*.md   text

# Treat these as binary.
*.png binary
*.ico binary
*.qm  binary
*.ktx binary
# The feedback sounds are PCM WAV: a line-ending or encoding conversion would
# make them undecodable, and data.sounds compares their bytes.
*.wav binary

# The interface's catalogues are generated by lupdate, which writes LF: the
# drift check compares them as text, so a checkout must not give them CRLF.
*.ts text eol=lf

# Git hooks are run by sh: LF only, whatever the checkout platform.
tools/hooks/* text eol=lf

# The vcpkg overlay ports are patched with git apply, which wants the bytes the patch was made from.
cmake/vcpkg-ports/** -text
