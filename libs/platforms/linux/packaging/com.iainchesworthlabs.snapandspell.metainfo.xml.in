<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (https://www.freedesktop.org/software/appstream/docs/).
     The @VERSION@ and @DATE@ release entry is filled in by build_appimage.sh.
     Validated by that script with appstreamcli (offline). -->
<component type="desktop-application">
  <id>com.iainchesworthlabs.snapandspell</id>
  <name>SnapAndSpell</name>
  <summary>Finds every word on a Boggle board</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <developer id="com.iainchesworthlabs">
    <name>Iain Chesworth</name>
  </developer>
  <description>
    <p>
      SnapAndSpell finds every word that can be made on a board of letters by
      moving from one tile to a neighbouring one without using a tile twice. Play
      the game on a board of dice you shake, or let the solver show you all the
      words you missed.
    </p>
  </description>
  <launchable type="desktop-id">com.iainchesworthlabs.snapandspell.desktop</launchable>
  <provides>
    <binary>SnapAndSpell</binary>
    <binary>sns-cli</binary>
  </provides>
  <url type="homepage">https://github.com/iainchesworthlabs/snapandspell</url>
  <url type="bugtracker">https://github.com/iainchesworthlabs/snapandspell/issues</url>
  <url type="vcs-browser">https://github.com/iainchesworthlabs/snapandspell</url>
  <categories>
    <category>Game</category>
    <category>LogicGame</category>
  </categories>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
