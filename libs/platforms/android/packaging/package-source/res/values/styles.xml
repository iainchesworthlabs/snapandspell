<?xml version="1.0" encoding="utf-8"?>
<!-- No action bar (the program draws its own header) and the page colour behind the
     first frame, so a launch is not a flash of the system's default window colour. -->
<resources>
    <style name="Theme.WordJewelsSolver" parent="android:Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/wjs_launch_background</item>
        <item name="android:colorBackground">@color/wjs_launch_background</item>
    </style>
</resources>
