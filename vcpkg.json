{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "wordjewelssolver",
  "version": "0.1.0",
  "description": "Finds every word on a Boggle board.",
  "homepage": "https://github.com/iainchesworthlabs/wordjewelssolver",
  "license": "GPL-3.0-or-later",
  "builtin-baseline": "2750401336fb7c95f6619657a46a7e798661341c",
  "overrides": [
    {
      "name": "tracy",
      "version": "0.14.1",
      "port-version": 1
    }
  ],
  "dependencies": [],
  "default-features": [],
  "features": {
    "tests": {
      "description": "Dependencies for the unit test suite",
      "dependencies": [
        "catch2"
      ]
    },
    "profiling": {
      "description": "Tracy profiler instrumentation (WJS_ENABLE_TRACY). Opt-in and never part of a shipped build: the profiling presets turn it on, so a normal build never pulls it in",
      "dependencies": [
        {
          "name": "tracy",
          "default-features": false,
          "features": [
            "on-demand"
          ]
        },
        {
          "name": "tracy",
          "host": true,
          "default-features": false,
          "features": [
            "cli-tools"
          ]
        }
      ]
    }
  }
}
