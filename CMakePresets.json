{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 0,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "WJS_BUILD_APP": "AUTO"
      }
    },
    {
      "name": "debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "WJS_ENABLE_TRACY": "ON"
      }
    },
    {
      "name": "release",
      "hidden": true,
      "description": "What a package is made from: Release, the Qt Quick application built (a missing Qt is an error, not a command-line-only package), no Tracy, no sanitizer runtime, reviewed phonics data required. A job that only wants the solver passes -DWJS_BUILD_APP=OFF.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "WJS_BUILD_APP": "ON",
        "WJS_ENABLE_TRACY": "OFF",
        "WJS_ENABLE_SANITIZERS": "OFF",
        "WJS_REQUIRE_REVIEWED_PHONICS": "ON"
      }
    },
    {
      "name": "tsan",
      "hidden": true,
      "inherits": ["debug"],
      "description": "ThreadSanitizer instead of AddressSanitizer and UBSan (the runtimes cannot be combined), and Tracy off. The Qt kit is prebuilt without instrumentation and would report races that are not there, so the application is not built: the solver, the scanner and the command line are, with their unit, integration and system tests.",
      "cacheVariables": {
        "WJS_ENABLE_SANITIZERS": "OFF",
        "WJS_ENABLE_TSAN": "ON",
        "WJS_ENABLE_TRACY": "OFF",
        "WJS_BUILD_APP": "OFF"
      }
    },
    {
      "name": "fastdebug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "profiling",
      "hidden": true,
      "inherits": [
        "fastdebug"
      ],
      "cacheVariables": {
        "WJS_ENABLE_TRACY": "ON",
        "WJS_ENABLE_SANITIZERS": "OFF"
      }
    },
    {
      "name": "windows-msvc-base",
      "hidden": true,
      "inherits": [
        "base"
      ],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "windows-msvc-debug",
      "displayName": "Windows (MSVC, Debug)",
      "inherits": [
        "windows-msvc-base",
        "debug"
      ]
    },
    {
      "name": "windows-msvc-release",
      "displayName": "Windows (MSVC, Release)",
      "inherits": [
        "windows-msvc-base",
        "release"
      ]
    },
    {
      "name": "windows-msvc-profiling",
      "displayName": "Windows (MSVC, Profiling: optimised, debug info, Tracy)",
      "inherits": [
        "windows-msvc-base",
        "profiling"
      ]
    },
    {
      "name": "windows-clang-coverage",
      "displayName": "Windows (ClangCL, Coverage)",
      "inherits": [
        "base"
      ],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "generator": "Visual Studio 18 2026",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "toolset": {
        "value": "ClangCL",
        "strategy": "set"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "WJS_BUILD_APP": "AUTO",
        "WJS_ENABLE_TRACY": "OFF",
        "WJS_ENABLE_COVERAGE": "ON",
        "WJS_ENABLE_SANITIZERS": "OFF",
        "WJS_REQUIRE_REVIEWED_PHONICS": "OFF"
      }
    },
    {
      "name": "windows-msvc-analysis",
      "displayName": "Windows (MSVC, static analysis)",
      "inherits": [
        "windows-msvc-base",
        "debug"
      ],
      "cacheVariables": {
        "WJS_BUILD_APP": "OFF",
        "WJS_BUILD_TESTS": "OFF",
        "WJS_ENABLE_TRACY": "OFF",
        "WJS_ENABLE_SANITIZERS": "OFF",
        "WJS_ENABLE_MSVC_ANALYSIS": "ON"
      }
    },
    {
      "name": "linux-gcc-analysis",
      "displayName": "Linux (GCC, static analysis: compile database only)",
      "description": "The lean tree the nightly clang-tidy and CodeQL jobs read: Debug, no tests, no Qt application, Tracy and the sanitizers off, so configuring it installs nothing through vcpkg.",
      "inherits": [
        "linux-gcc-base",
        "debug"
      ],
      "cacheVariables": {
        "WJS_BUILD_APP": "OFF",
        "WJS_BUILD_TESTS": "OFF",
        "WJS_ENABLE_TRACY": "OFF",
        "WJS_ENABLE_SANITIZERS": "OFF",
        "CMAKE_CXX_SCAN_FOR_MODULES": "OFF"
      }
    },
    {
      "name": "linux-gcc-base",
      "hidden": true,
      "inherits": [
        "base"
      ],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "linux-gcc-debug",
      "displayName": "Linux (GCC, Debug)",
      "inherits": [
        "linux-gcc-base",
        "debug"
      ]
    },
    {
      "name": "linux-gcc-release",
      "displayName": "Linux (GCC, Release)",
      "inherits": [
        "linux-gcc-base",
        "release"
      ]
    },
    {
      "name": "linux-gcc-profiling",
      "displayName": "Linux (GCC, Profiling: optimised, debug info, Tracy)",
      "inherits": [
        "linux-gcc-base",
        "profiling"
      ]
    },
    {
      "name": "linux-gcc-coverage",
      "displayName": "Linux (GCC, Coverage)",
      "inherits": [
        "linux-gcc-base",
        "debug"
      ],
      "cacheVariables": {
        "WJS_ENABLE_TRACY": "OFF",
        "WJS_ENABLE_COVERAGE": "ON",
        "WJS_ENABLE_SANITIZERS": "OFF"
      }
    },
    {
      "name": "linux-clang-base",
      "hidden": true,
      "inherits": [
        "base"
      ],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "linux-clang-debug",
      "displayName": "Linux (Clang, Debug)",
      "inherits": [
        "linux-clang-base",
        "debug"
      ]
    },
    {
      "name": "linux-clang-tsan",
      "displayName": "Linux (Clang, ThreadSanitizer)",
      "inherits": [
        "tsan",
        "linux-clang-base"
      ]
    },
    {
      "name": "linux-fuzz",
      "displayName": "Linux (Clang, libFuzzer harnesses)",
      "description": "Builds the libraries and the libFuzzer harnesses only (libs/<lib>/fuzz), with AddressSanitizer and UBSan; ctest --preset linux-fuzz replays the seed corpus and the past crashes. Debug, so the standard library's assertions are on; no Tracy, no Qt application, no tests, and no hardening flags (a fortified libc call bypasses AddressSanitizer).",
      "inherits": [
        "linux-clang-base",
        "debug"
      ],
      "cacheVariables": {
        "WJS_ENABLE_FUZZING": "ON",
        "WJS_ENABLE_SANITIZERS": "OFF",
        "WJS_ENABLE_TRACY": "OFF",
        "WJS_ENABLE_HARDENING": "OFF",
        "WJS_BUILD_APP": "OFF",
        "WJS_BUILD_CLI": "OFF",
        "WJS_BUILD_TESTS": "OFF",
        "CMAKE_CXX_SCAN_FOR_MODULES": "OFF"
      }
    },
    {
      "name": "macos-clang-base",
      "hidden": true,
      "inherits": [
        "base"
      ],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-osx"
      }
    },
    {
      "name": "macos-clang-debug",
      "displayName": "macOS (Clang, Debug)",
      "inherits": [
        "macos-clang-base",
        "debug"
      ]
    },
    {
      "name": "macos-clang-release",
      "displayName": "macOS (Clang, Release)",
      "inherits": [
        "macos-clang-base",
        "release"
      ]
    },
    {
      "name": "macos-clang-profiling",
      "displayName": "macOS (Clang, Profiling: optimised, debug info, Tracy)",
      "inherits": [
        "macos-clang-base",
        "profiling"
      ]
    },
    {
      "name": "ios-base",
      "hidden": true,
      "description": "An iPhone or iPad (arm64), built by Xcode from a Mac with Qt's iOS kit (QT_ROOT_DIR) and a desktop Qt of the same version for its host tools (QT_HOST_PATH). vcpkg's toolchain is the CMAKE_TOOLCHAIN_FILE like everywhere else and chains to Qt's; the manifest has no dependency without the tests or Tracy, so vcpkg installs nothing. Unsigned unless WJS_IOS_SIGNING_TEAM and WJS_IOS_SIGNING_PROFILE are given (docs/building.md, iOS).",
      "inherits": [
        "base"
      ],
      "generator": "Xcode",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "OFF",
        "VCPKG_TARGET_TRIPLET": "arm64-ios",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{QT_ROOT_DIR}/lib/cmake/Qt6/qt.toolchain.cmake",
        "QT_HOST_PATH": "$env{QT_HOST_PATH}",
        "CMAKE_OSX_SYSROOT": "iphoneos",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "18.0",
        "CMAKE_XCODE_GENERATE_SCHEME": "ON",
        "WJS_BUILD_CLI": "OFF",
        "WJS_BUILD_TESTS": "OFF",
        "CMAKE_XCODE_ATTRIBUTE_CODE_SIGNING_ALLOWED": "NO",
        "CMAKE_XCODE_ATTRIBUTE_CODE_SIGNING_REQUIRED": "NO",
        "CMAKE_XCODE_ATTRIBUTE_CODE_SIGN_IDENTITY": ""
      }
    },
    {
      "name": "ios-release",
      "displayName": "iOS (device, Release)",
      "inherits": [
        "ios-base",
        "release"
      ]
    },
    {
      "name": "android-arm64-base",
      "hidden": true,
      "description": "An Android tablet or phone (arm64-v8a), built from any host with Qt's Android kit (QT_ANDROID_DIR), a desktop Qt of the same version for its host tools and androiddeployqt (QT_HOST_PATH), the Android SDK (ANDROID_SDK_ROOT) and the NDK the kit was built with (ANDROID_NDK_ROOT), and a JDK 17 or later. vcpkg's toolchain is the CMAKE_TOOLCHAIN_FILE like everywhere else and chains to Qt's; the manifest has no dependency without the tests or Tracy, so vcpkg installs nothing. Tracy is off in every Android preset: its client listens on the network, and the application holds no network permission (docs/building.md, Android). The C++ module dependency scan is off: nothing here uses modules, and on a Windows host its command line, with Qt's definitions, exceeds what cmd.exe runs. `cmake --build --preset <name>` makes the package.",
      "inherits": [
        "base"
      ],
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-android",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{QT_ANDROID_DIR}/lib/cmake/Qt6/qt.toolchain.cmake",
        "QT_HOST_PATH": "$env{QT_HOST_PATH}",
        "ANDROID_SDK_ROOT": "$env{ANDROID_SDK_ROOT}",
        "ANDROID_NDK_ROOT": "$env{ANDROID_NDK_ROOT}",
        "CMAKE_CXX_SCAN_FOR_MODULES": "OFF",
        "WJS_BUILD_APP": "ON",
        "WJS_BUILD_CLI": "OFF",
        "WJS_BUILD_TESTS": "OFF",
        "WJS_ENABLE_TRACY": "OFF",
        "WJS_ENABLE_SANITIZERS": "OFF"
      }
    },
    {
      "name": "android-arm64-release",
      "displayName": "Android (arm64-v8a, Release)",
      "description": "What a release is made from. The package (`apk` or `aab` target) is unsigned unless QT_ANDROID_SIGN_APK / QT_ANDROID_SIGN_AAB are ON and the QT_ANDROID_KEYSTORE_* environment variables name the upload key (tools/release/new_android_keystore.sh makes one; docs/ci.md, Android).",
      "inherits": [
        "android-arm64-base",
        "release"
      ]
    },
    {
      "name": "android-arm64-debuggable",
      "displayName": "Android (arm64-v8a, debuggable, debug-signed)",
      "description": "A debuggable package signed with Android's own debug key, which installs on any device that allows it. Not named *-debug: the debug presets have Tracy on by policy, and no Android build does (tests/profiling/check_presets.cmake).",
      "inherits": [
        "android-arm64-base"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "QT_ANDROID_DEPLOYMENT_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-msvc-debug", "configurePreset": "windows-msvc-debug" },
    { "name": "windows-msvc-release", "configurePreset": "windows-msvc-release" },
    { "name": "linux-gcc-debug", "configurePreset": "linux-gcc-debug" },
    { "name": "linux-gcc-release", "configurePreset": "linux-gcc-release" },
    { "name": "linux-gcc-coverage", "configurePreset": "linux-gcc-coverage" },
    { "name": "macos-clang-debug", "configurePreset": "macos-clang-debug" },
    { "name": "macos-clang-release", "configurePreset": "macos-clang-release" },
    { "name": "windows-msvc-profiling", "configurePreset": "windows-msvc-profiling" },
    { "name": "windows-clang-coverage", "configurePreset": "windows-clang-coverage", "configuration": "Debug" },
    { "name": "linux-gcc-profiling", "configurePreset": "linux-gcc-profiling" },
    { "name": "macos-clang-profiling", "configurePreset": "macos-clang-profiling" },
    { "name": "windows-msvc-analysis", "configurePreset": "windows-msvc-analysis" },
    { "name": "linux-gcc-analysis", "configurePreset": "linux-gcc-analysis" },
    { "name": "linux-clang-debug", "configurePreset": "linux-clang-debug" },
    { "name": "linux-clang-tsan", "configurePreset": "linux-clang-tsan" },
    { "name": "linux-fuzz", "configurePreset": "linux-fuzz" },
    { "name": "ios-release", "configurePreset": "ios-release", "configuration": "Release", "targets": ["WordJewelsSolver"] },
    { "name": "android-arm64-release", "configurePreset": "android-arm64-release", "targets": ["apk"] },
    { "name": "android-arm64-debuggable", "configurePreset": "android-arm64-debuggable", "targets": ["apk"] }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-asan",
      "hidden": true,
      "description": "MSVC's AddressSanitizer keeps 30 frames for every allocation and free (RtlCaptureStackBackTrace), which is most of the time of a test that allocates. Two frames find every bad access as before, with the full stack of the access; only the 'allocated by' and 'freed by' stacks are cut, to the allocating function. A value of ASAN_OPTIONS set by the caller comes after this one and wins (malloc_context_size=30 for the whole stacks).",
      "environment": { "ASAN_OPTIONS": "malloc_context_size=2:$penv{ASAN_OPTIONS}" }
    },
    { "name": "windows-msvc-debug", "configurePreset": "windows-msvc-debug", "inherits": ["base", "windows-asan"] },
    { "name": "windows-msvc-release", "configurePreset": "windows-msvc-release", "inherits": ["base"] },
    { "name": "windows-clang-coverage", "configurePreset": "windows-clang-coverage", "inherits": ["base"], "configuration": "Debug" },
    { "name": "linux-gcc-debug", "configurePreset": "linux-gcc-debug", "inherits": ["base"] },
    { "name": "linux-gcc-release", "configurePreset": "linux-gcc-release", "inherits": ["base"] },
    { "name": "linux-gcc-coverage", "configurePreset": "linux-gcc-coverage", "inherits": ["base"] },
    { "name": "macos-clang-debug", "configurePreset": "macos-clang-debug", "inherits": ["base"] },
    { "name": "macos-clang-release", "configurePreset": "macos-clang-release", "inherits": ["base"] },
    { "name": "windows-msvc-profiling", "configurePreset": "windows-msvc-profiling", "inherits": ["base"] },
    { "name": "linux-gcc-profiling", "configurePreset": "linux-gcc-profiling", "inherits": ["base"] },
    { "name": "macos-clang-profiling", "configurePreset": "macos-clang-profiling", "inherits": ["base"] },
    { "name": "linux-clang-debug", "configurePreset": "linux-clang-debug", "inherits": ["base"] },
    {
      "name": "linux-fuzz",
      "configurePreset": "linux-fuzz",
      "inherits": ["base"],
      "filter": { "include": { "label": "fuzz" } }
    },
    {
      "name": "linux-clang-tsan",
      "configurePreset": "linux-clang-tsan",
      "inherits": ["base"],
      "environment": { "TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1:suppressions=${sourceDir}/tools/sanitizers/tsan.supp:$penv{TSAN_OPTIONS}" }
    },
    {
      "name": "unit",
      "hidden": true,
      "inherits": ["base"],
      "filter": { "include": { "label": "unit" } }
    },
    {
      "name": "integration",
      "hidden": true,
      "inherits": ["base"],
      "filter": { "include": { "name": "^integration\\." } }
    },
    {
      "name": "system",
      "hidden": true,
      "inherits": ["base"],
      "filter": { "include": { "label": "system" } }
    },
    {
      "name": "ui",
      "hidden": true,
      "inherits": ["base"],
      "filter": { "include": { "label": "ui" } }
    },
    { "name": "windows-msvc-debug-unit", "configurePreset": "windows-msvc-debug", "inherits": ["unit", "windows-asan"] },
    { "name": "windows-msvc-debug-integration", "configurePreset": "windows-msvc-debug", "inherits": ["integration", "windows-asan"] },
    { "name": "windows-msvc-debug-system", "configurePreset": "windows-msvc-debug", "inherits": ["system", "windows-asan"] },
    { "name": "windows-msvc-debug-ui", "configurePreset": "windows-msvc-debug", "inherits": ["ui", "windows-asan"] },
    { "name": "linux-gcc-debug-unit", "configurePreset": "linux-gcc-debug", "inherits": ["unit"] },
    { "name": "linux-gcc-debug-integration", "configurePreset": "linux-gcc-debug", "inherits": ["integration"] },
    { "name": "linux-gcc-debug-system", "configurePreset": "linux-gcc-debug", "inherits": ["system"] },
    { "name": "linux-gcc-debug-ui", "configurePreset": "linux-gcc-debug", "inherits": ["ui"] },
    { "name": "macos-clang-debug-unit", "configurePreset": "macos-clang-debug", "inherits": ["unit"] },
    { "name": "macos-clang-debug-integration", "configurePreset": "macos-clang-debug", "inherits": ["integration"] },
    { "name": "macos-clang-debug-system", "configurePreset": "macos-clang-debug", "inherits": ["system"] },
    { "name": "macos-clang-debug-ui", "configurePreset": "macos-clang-debug", "inherits": ["ui"] },
    {
      "name": "perf",
      "hidden": true,
      "inherits": ["base"],
      "filter": { "include": { "label": "perf" } },
      "environment": { "WJS_PERF_TIMING": "1" }
    },
    { "name": "windows-msvc-perf", "configurePreset": "windows-msvc-release", "inherits": ["perf"] },
    { "name": "linux-gcc-perf", "configurePreset": "linux-gcc-release", "inherits": ["perf"] },
    { "name": "macos-clang-perf", "configurePreset": "macos-clang-release", "inherits": ["perf"] }
  ],
  "packagePresets": [
    {
      "name": "package-windows-msvc-release",
      "displayName": "Windows (MSVC, Release) package",
      "configurePreset": "windows-msvc-release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "package-linux-gcc-release",
      "displayName": "Linux (GCC, Release) package",
      "configurePreset": "linux-gcc-release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "package-macos-clang-release",
      "displayName": "macOS (Clang, Release) package",
      "configurePreset": "macos-clang-release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    }
  ]
}
