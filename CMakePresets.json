{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 0,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "WJS_BUILD_APP": "AUTO"
      }
    },
    {
      "name": "debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "WJS_ENABLE_TRACY": "ON"
      }
    },
    {
      "name": "release",
      "hidden": true,
      "description": "What a package is made from: Release, the Qt Quick application built (a missing Qt is an error, not a command-line-only package), no Tracy, no sanitizer runtime, reviewed phonics data required. A job that only wants the solver passes -DWJS_BUILD_APP=OFF.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "WJS_BUILD_APP": "ON",
        "WJS_ENABLE_TRACY": "OFF",
        "WJS_ENABLE_SANITIZERS": "OFF",
        "WJS_REQUIRE_REVIEWED_PHONICS": "ON"
      }
    },
    {
      "name": "fastdebug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "profiling",
      "hidden": true,
      "inherits": [
        "fastdebug"
      ],
      "cacheVariables": {
        "WJS_ENABLE_TRACY": "ON",
        "WJS_ENABLE_SANITIZERS": "OFF"
      }
    },
    {
      "name": "windows-msvc-base",
      "hidden": true,
      "inherits": [
        "base"
      ],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "windows-msvc-debug",
      "displayName": "Windows (MSVC, Debug)",
      "inherits": [
        "windows-msvc-base",
        "debug"
      ]
    },
    {
      "name": "windows-msvc-release",
      "displayName": "Windows (MSVC, Release)",
      "inherits": [
        "windows-msvc-base",
        "release"
      ]
    },
    {
      "name": "windows-msvc-profiling",
      "displayName": "Windows (MSVC, Profiling: optimised, debug info, Tracy)",
      "inherits": [
        "windows-msvc-base",
        "profiling"
      ]
    },
    {
      "name": "windows-clang-coverage",
      "displayName": "Windows (ClangCL, Coverage)",
      "inherits": [
        "base"
      ],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "generator": "Visual Studio 18 2026",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "toolset": {
        "value": "ClangCL",
        "strategy": "set"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "WJS_BUILD_APP": "AUTO",
        "WJS_ENABLE_TRACY": "OFF",
        "WJS_ENABLE_COVERAGE": "ON",
        "WJS_ENABLE_SANITIZERS": "OFF",
        "WJS_REQUIRE_REVIEWED_PHONICS": "OFF"
      }
    },
    {
      "name": "windows-msvc-analysis",
      "displayName": "Windows (MSVC, static analysis)",
      "inherits": [
        "windows-msvc-base",
        "debug"
      ],
      "cacheVariables": {
        "WJS_BUILD_APP": "OFF",
        "WJS_BUILD_TESTS": "OFF",
        "WJS_ENABLE_TRACY": "OFF",
        "WJS_ENABLE_SANITIZERS": "OFF",
        "WJS_ENABLE_MSVC_ANALYSIS": "ON"
      }
    },
    {
      "name": "linux-gcc-analysis",
      "displayName": "Linux (GCC, static analysis: compile database only)",
      "description": "The lean tree the nightly clang-tidy and CodeQL jobs read: Debug, no tests, no Qt application, Tracy and the sanitizers off, so configuring it installs nothing through vcpkg.",
      "inherits": [
        "linux-gcc-base",
        "debug"
      ],
      "cacheVariables": {
        "WJS_BUILD_APP": "OFF",
        "WJS_BUILD_TESTS": "OFF",
        "WJS_ENABLE_TRACY": "OFF",
        "WJS_ENABLE_SANITIZERS": "OFF",
        "CMAKE_CXX_SCAN_FOR_MODULES": "OFF"
      }
    },
    {
      "name": "linux-gcc-base",
      "hidden": true,
      "inherits": [
        "base"
      ],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "linux-gcc-debug",
      "displayName": "Linux (GCC, Debug)",
      "inherits": [
        "linux-gcc-base",
        "debug"
      ]
    },
    {
      "name": "linux-gcc-release",
      "displayName": "Linux (GCC, Release)",
      "inherits": [
        "linux-gcc-base",
        "release"
      ]
    },
    {
      "name": "linux-gcc-profiling",
      "displayName": "Linux (GCC, Profiling: optimised, debug info, Tracy)",
      "inherits": [
        "linux-gcc-base",
        "profiling"
      ]
    },
    {
      "name": "linux-gcc-coverage",
      "displayName": "Linux (GCC, Coverage)",
      "inherits": [
        "linux-gcc-base",
        "debug"
      ],
      "cacheVariables": {
        "WJS_ENABLE_TRACY": "OFF",
        "WJS_ENABLE_COVERAGE": "ON",
        "WJS_ENABLE_SANITIZERS": "OFF"
      }
    },
    {
      "name": "linux-clang-base",
      "hidden": true,
      "inherits": [
        "base"
      ],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "linux-clang-debug",
      "displayName": "Linux (Clang, Debug)",
      "inherits": [
        "linux-clang-base",
        "debug"
      ]
    },
    {
      "name": "macos-clang-base",
      "hidden": true,
      "inherits": [
        "base"
      ],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-osx"
      }
    },
    {
      "name": "macos-clang-debug",
      "displayName": "macOS (Clang, Debug)",
      "inherits": [
        "macos-clang-base",
        "debug"
      ]
    },
    {
      "name": "macos-clang-release",
      "displayName": "macOS (Clang, Release)",
      "inherits": [
        "macos-clang-base",
        "release"
      ]
    },
    {
      "name": "macos-clang-profiling",
      "displayName": "macOS (Clang, Profiling: optimised, debug info, Tracy)",
      "inherits": [
        "macos-clang-base",
        "profiling"
      ]
    }
  ],
  "buildPresets": [
    { "name": "windows-msvc-debug", "configurePreset": "windows-msvc-debug" },
    { "name": "windows-msvc-release", "configurePreset": "windows-msvc-release" },
    { "name": "linux-gcc-debug", "configurePreset": "linux-gcc-debug" },
    { "name": "linux-gcc-release", "configurePreset": "linux-gcc-release" },
    { "name": "linux-gcc-coverage", "configurePreset": "linux-gcc-coverage" },
    { "name": "macos-clang-debug", "configurePreset": "macos-clang-debug" },
    { "name": "macos-clang-release", "configurePreset": "macos-clang-release" },
    { "name": "windows-msvc-profiling", "configurePreset": "windows-msvc-profiling" },
    { "name": "windows-clang-coverage", "configurePreset": "windows-clang-coverage", "configuration": "Debug" },
    { "name": "linux-gcc-profiling", "configurePreset": "linux-gcc-profiling" },
    { "name": "macos-clang-profiling", "configurePreset": "macos-clang-profiling" },
    { "name": "windows-msvc-analysis", "configurePreset": "windows-msvc-analysis" },
    { "name": "linux-gcc-analysis", "configurePreset": "linux-gcc-analysis" },
    { "name": "linux-clang-debug", "configurePreset": "linux-clang-debug" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    { "name": "windows-msvc-debug", "configurePreset": "windows-msvc-debug", "inherits": ["base"] },
    { "name": "windows-msvc-release", "configurePreset": "windows-msvc-release", "inherits": ["base"] },
    { "name": "windows-clang-coverage", "configurePreset": "windows-clang-coverage", "inherits": ["base"], "configuration": "Debug" },
    { "name": "linux-gcc-debug", "configurePreset": "linux-gcc-debug", "inherits": ["base"] },
    { "name": "linux-gcc-release", "configurePreset": "linux-gcc-release", "inherits": ["base"] },
    { "name": "linux-gcc-coverage", "configurePreset": "linux-gcc-coverage", "inherits": ["base"] },
    { "name": "macos-clang-debug", "configurePreset": "macos-clang-debug", "inherits": ["base"] },
    { "name": "macos-clang-release", "configurePreset": "macos-clang-release", "inherits": ["base"] },
    { "name": "windows-msvc-profiling", "configurePreset": "windows-msvc-profiling", "inherits": ["base"] },
    { "name": "linux-gcc-profiling", "configurePreset": "linux-gcc-profiling", "inherits": ["base"] },
    { "name": "macos-clang-profiling", "configurePreset": "macos-clang-profiling", "inherits": ["base"] },
    { "name": "linux-clang-debug", "configurePreset": "linux-clang-debug", "inherits": ["base"] },
    {
      "name": "unit",
      "hidden": true,
      "inherits": ["base"],
      "filter": { "include": { "label": "unit" } }
    },
    {
      "name": "integration",
      "hidden": true,
      "inherits": ["base"],
      "filter": { "include": { "name": "^integration\\." } }
    },
    {
      "name": "system",
      "hidden": true,
      "inherits": ["base"],
      "filter": { "include": { "label": "system" } }
    },
    {
      "name": "ui",
      "hidden": true,
      "inherits": ["base"],
      "filter": { "include": { "label": "ui" } }
    },
    { "name": "windows-msvc-debug-unit", "configurePreset": "windows-msvc-debug", "inherits": ["unit"] },
    { "name": "windows-msvc-debug-integration", "configurePreset": "windows-msvc-debug", "inherits": ["integration"] },
    { "name": "windows-msvc-debug-system", "configurePreset": "windows-msvc-debug", "inherits": ["system"] },
    { "name": "windows-msvc-debug-ui", "configurePreset": "windows-msvc-debug", "inherits": ["ui"] },
    { "name": "linux-gcc-debug-unit", "configurePreset": "linux-gcc-debug", "inherits": ["unit"] },
    { "name": "linux-gcc-debug-integration", "configurePreset": "linux-gcc-debug", "inherits": ["integration"] },
    { "name": "linux-gcc-debug-system", "configurePreset": "linux-gcc-debug", "inherits": ["system"] },
    { "name": "linux-gcc-debug-ui", "configurePreset": "linux-gcc-debug", "inherits": ["ui"] },
    { "name": "macos-clang-debug-unit", "configurePreset": "macos-clang-debug", "inherits": ["unit"] },
    { "name": "macos-clang-debug-integration", "configurePreset": "macos-clang-debug", "inherits": ["integration"] },
    { "name": "macos-clang-debug-system", "configurePreset": "macos-clang-debug", "inherits": ["system"] },
    { "name": "macos-clang-debug-ui", "configurePreset": "macos-clang-debug", "inherits": ["ui"] },
    {
      "name": "perf",
      "hidden": true,
      "inherits": ["base"],
      "filter": { "include": { "label": "perf" } },
      "environment": { "WJS_PERF_TIMING": "1" }
    },
    { "name": "windows-msvc-perf", "configurePreset": "windows-msvc-release", "inherits": ["perf"] },
    { "name": "linux-gcc-perf", "configurePreset": "linux-gcc-release", "inherits": ["perf"] },
    { "name": "macos-clang-perf", "configurePreset": "macos-clang-release", "inherits": ["perf"] }
  ],
  "packagePresets": [
    {
      "name": "package-windows-msvc-release",
      "displayName": "Windows (MSVC, Release) package",
      "configurePreset": "windows-msvc-release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "package-linux-gcc-release",
      "displayName": "Linux (GCC, Release) package",
      "configurePreset": "linux-gcc-release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "package-macos-clang-release",
      "displayName": "macOS (Clang, Release) package",
      "configurePreset": "macos-clang-release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    }
  ]
}
