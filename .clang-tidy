---
# Static analysis for first-party code. Kept in step with the compiler warning
# set in cmake/CompilerWarnings.cmake. The nightly analysis workflow pins
# clang-tidy (.github/requirements/analysis.txt) and runs this file over src/
# with warnings as errors (docs/ci.md, "Nightly analysis"). A bump of that pin
# is the moment a check added in a newer clang-tidy can appear.
#
# Checks that are on but disabled, and why:
#
#   cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
#   cppcoreguidelines-pro-bounds-constant-array-index,
#   cppcoreguidelines-pro-bounds-pointer-arithmetic
#     These fire on every operator[] and pointer step that is guarded by an
#     explicit size check or a loop bound. The scanner indexes pixels and the
#     parsers walk strings that way on purpose, and .at() would turn a checked
#     hot loop into an exception path. -Warray-bounds, the sanitizer legs and
#     the unit tests cover the mistake these checks look for.
#
#   cppcoreguidelines-avoid-const-or-ref-data-members
#     A short-lived view type that holds a reference is the point of the type;
#     the guideline is about assignable value types.
#
#   modernize-use-designated-initializers, modernize-use-ranges,
#   readability-math-missing-parentheses
#     Stylistic rewrites: C++20 designated initializers, ranges algorithms in
#     place of an index or iterator loop, and extra parentheses around
#     arithmetic whose precedence is already clear.
#
#   bugprone-easily-swappable-parameters
#     Every (row, column), (width, height) and (from, to) pair is "easily
#     swapped"; strong types for all of them would be a redesign of the APIs the
#     application and the tests use.
#
#   performance-enum-size
#     The underlying type of an enum is part of a public header's interface, and
#     a byte saved in a setting or an error value is not a performance problem.
#     Leaving it to the compiler keeps the headers' ABI stable.
#
#   clang-analyzer-optin.core.EnumCastOutOfRange
#     Reports a false positive inside MSVC's own <filesystem> bitmask helpers,
#     which the analyzer reports even though the header is external.
Checks: >
  bugprone-*,
  cppcoreguidelines-*,
  modernize-*,
  performance-*,
  readability-*,
  clang-analyzer-*,
  -modernize-use-trailing-return-type,
  -readability-identifier-length,
  -cppcoreguidelines-avoid-magic-numbers,
  -readability-magic-numbers,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-avoid-const-or-ref-data-members,
  -modernize-use-designated-initializers,
  -modernize-use-ranges,
  -readability-math-missing-parentheses,
  -bugprone-easily-swappable-parameters,
  -performance-enum-size,
  -clang-analyzer-optin.core.EnumCastOutOfRange

WarningsAsErrors: ''
HeaderFilterRegex: 'src/.*'
FormatStyle: file

CheckOptions:
  # Catch2's REQUIRE/CHECK/CAPTURE expand to a do-while with a try/catch and an
  # && chain each - about five points of cognitive complexity per assertion
  # before any nesting - so a test case with more than a handful of assertions
  # exceeds the default threshold of 25 whatever it does itself. Complexity is
  # judged on what the function's own code does; the check still applies in
  # full to production code.
  readability-function-cognitive-complexity.IgnoreMacros: true
  # The board seeder and the phase/store parsers are deliberately single-pass
  # and already split into named helpers below this level. The threshold sits
  # above the current maximum so the check still catches a function that grows
  # past it, without failing on the ones that are as complex as they need to be.
  readability-function-cognitive-complexity.Threshold: 150
