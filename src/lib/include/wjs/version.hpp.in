#pragma once

#include <string>
#include <string_view>

namespace wjs {

// The semantic version, the platform and the compiler this binary was built
// for. These are values the build system names (CMakeLists.txt and
// cmake/Platform.cmake); the source asks no operating system anything
// (docs/platform-isolation.md).

inline constexpr std::string_view project_version = "@PROJECT_VERSION@";
inline constexpr std::string_view target_platform = "@WJS_PLATFORM_DISPLAY_NAME@";
inline constexpr std::string_view build_target = "@WJS_VERSION_TARGET@";

// Git provenance, stamped when CMake configured the build. "unknown" where git
// could not be asked (a source tarball); a checkout with new commits is
// restamped by the next configure.
inline constexpr std::string_view git_commit = "@WJS_GIT_COMMIT@";
inline constexpr std::string_view git_describe = "@WJS_GIT_DESCRIBE@";
inline constexpr std::string_view git_branch = "@WJS_GIT_BRANCH@";
inline constexpr bool git_dirty = @WJS_GIT_DIRTY@;

// One multi-line, human-readable block of version and build provenance, for an
// About screen or a --version line.
[[nodiscard]] std::string version_details();

}  // namespace wjs
